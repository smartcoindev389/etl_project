# ==========================================
# ETL Project - Environment Configuration
# ==========================================
# 
# Copy this file to .env and update with your actual values
# Command: cp env.example .env
#
# IMPORTANT: Never commit .env to version control!
# ==========================================

# ==========================================
# Local MySQL Database Configuration
# ==========================================
# Used for development and testing
# Default: localhost:3306

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=etl_project

# ==========================================
# Cloud MySQL Database Configuration
# ==========================================
# Required for production deployment
# Get credentials from your cloud provider (Railway, PlanetScale, AWS RDS, etc.)
# 
# See CLOUD_SETUP_GUIDE.md for setup instructions
# ==========================================

# Cloud MySQL Host (e.g., containers-us-west-xxx.railway.app)
CLOUD_DB_HOST=

# Cloud MySQL Port (usually 3306)
CLOUD_DB_PORT=3306

# Cloud MySQL Username
CLOUD_DB_USER=

# Cloud MySQL Password
CLOUD_DB_PASSWORD=

# Cloud MySQL Database Name
CLOUD_DB_NAME=etl_project

# ==========================================
# ETL Processing Configuration
# ==========================================

# Base path for CSV files
# Default: ./data
# Examples:
#   CSV_BASE_PATH=./data
#   CSV_BASE_PATH=/path/to/csv/files
#   CSV_BASE_PATH=./fending data
CSV_BASE_PATH=./data

# Batch size for database inserts
# Larger batches = faster but more memory
# Default: 10000
# Recommended range: 5000-20000
BATCH_SIZE=10000

# ==========================================
# Optional: Advanced Configuration
# ==========================================
# These settings are optional and have defaults
# Uncomment and adjust if needed

# Date format for monthly data extraction
# Default: %Y-%m-%d
# DATE_FORMAT=%Y-%m-%d

# Processing timeout (seconds)
# Default: 3600 (1 hour)
# PROCESSING_TIMEOUT=3600

# Enable verbose logging
# Default: false
# Set to 'true' for detailed logs
# VERBOSE_LOGGING=false

# ==========================================
# Example Configurations by Provider
# ==========================================

# --- Railway Example ---
# CLOUD_DB_HOST=containers-us-west-xxx.railway.app
# CLOUD_DB_PORT=3306
# CLOUD_DB_USER=root
# CLOUD_DB_PASSWORD=your_password_from_railway
# CLOUD_DB_NAME=railway

# --- AWS RDS Example ---
# CLOUD_DB_HOST=your-db.xxxxxxxxx.us-east-1.rds.amazonaws.com
# CLOUD_DB_PORT=3306
# CLOUD_DB_USER=admin
# CLOUD_DB_PASSWORD=your_aws_password
# CLOUD_DB_NAME=etl_project

# --- PlanetScale Example ---
# CLOUD_DB_HOST=xxxxx.us-east-2.psdb.cloud
# CLOUD_DB_PORT=3306
# CLOUD_DB_USER=xxxxx
# CLOUD_DB_PASSWORD=your_planetscale_password
# CLOUD_DB_NAME=etl_project

# --- Aiven Example ---
# CLOUD_DB_HOST=your-instance.aivencloud.com
# CLOUD_DB_PORT=3306
# CLOUD_DB_USER=avnadmin
# CLOUD_DB_PASSWORD=your_aiven_password
# CLOUD_DB_NAME=defaultdb

# ==========================================
# Notes
# ==========================================
#
# 1. For local development:
#    - Configure DB_* variables only
#    - Leave CLOUD_DB_* empty
#
# 2. For production:
#    - Configure CLOUD_DB_* variables
#    - You can keep local config for fallback
#
# 3. Security:
#    - Use strong passwords
#    - Never commit .env to git
#    - Rotate passwords regularly
#
# 4. Testing:
#    - Test connection: python test_mysql_connection.py --cloud
#    - Initialize database: python database/init_database.py --cloud
#
# ==========================================

